{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/*/vitest.config.ts",
    "services/*/src/**/*.ts",
    "services/*/test/**/*.ts",
    "services/*/vitest.config.ts",
    "apps/*/src/**/*.ts",
    "apps/*/generated/**/*.ts",
    "apps/*/test/**/*.ts",
    "apps/*/vitest.config.ts",
    "verticals/*/tests/**/*.ts",
    "verticals/*/fixtures/**/*.ts",
    "tooling/**/*.ts",
    "tests/**/*.ts",
    "types/**/*.d.ts",
    "vitest.config.ts",
    "vitest.workspace.ts"
  ],
  "exclude": ["**/node_modules", "**/dist", ".agentworkforce"]
}
