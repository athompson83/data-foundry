# Normalize line endings so Windows checkouts do not churn the diff for
# collaborators on macOS/Linux. Text is stored LF in the repository.
* text=auto eol=lf

*.sql   text eol=lf
*.md    text eol=lf
*.ts    text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf

*.pdf   binary
*.png   binary
*.jpg   binary
*.parquet binary

# Captured source evidence is committed byte-for-byte: its SHA-256 is cited by
# rights determinations, so line endings must not be normalized.
docs/sources/evidence/vehicles/** -text
