    "typecheck": "tsc -p tsconfig.json",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@data-foundry/canonical-store": "workspace:*",
    "@data-foundry/private-canary": "workspace:*",
    "@data-foundry/usage-events": "workspace:*",
    "pg": "^8.23.0"
  }
}
