{
  "vertical_slug": "hvac",
  "vertical_name": "HVAC Equipment",
  "vertical_status": "DRAFT",
  "entity_types": [
    "manufacturer",
    "equipment_model",
    "certification"
  ],
  "entity_type_meta": {
    "manufacturer": {
      "label_singular": "Manufacturer",
      "label_plural": "Manufacturers",
      "canonical_slug_pattern": "{canonical_name}"
    },
    "equipment_model": {
      "label_singular": "Equipment Model",
      "label_plural": "Equipment Models",
      "canonical_slug_pattern": "{manufacturer_slug}-{model_number}"
    },
    "certification": {
      "label_singular": "Certification",
      "label_plural": "Certifications",
      "canonical_slug_pattern": "{ahri_ref}"
    }
  },
  "relationship_predicates": [
    "manufactures",
    "supersedes",
    "certified_by",
    "compatible_with"
  ],
  "fields": [
