  "fact_selection": {
    "requirePublishableRights": true,
    "authoritativeSourceTypes": [
      "REGULATORY",
      "STANDARDS_BODY",
      "CERTIFICATION_BODY",
      "REGULATORY_FILING",
      "MANUFACTURER"
    ],
    "authoritativeSourcesByProperty": {},
    "fieldReliability": {},
    "editorialOverrides": [],
    "consistencyChecks": [
      {
        "id": "value_type_agreement",
        "describe": "normalized_value matches its declared value_type"
      },
      {
        "id": "quantity_requires_unit",
        "describe": "quantity values carry a unit"
      },
      {
        "id": "non_empty_value",
        "describe": "value is not empty"
      },
      {
        "id": "numeric_range:model_year",
        "describe": "model_year within [1949, 2030]"
      },
      {
        "id": "numeric_range:city_mpg",
        "describe": "city_mpg within [5, 200]"
      },
      {
        "id": "numeric_range:highway_mpg",
        "describe": "highway_mpg within [5, 200]"
      },
      {
        "id": "numeric_range:combined_mpg",
        "describe": "combined_mpg within [5, 200]"
      },
      {
        "id": "numeric_range:cylinders",
        "describe": "cylinders within [2, 16]"
      },
      {
        "id": "numeric_range:displacement_l",
        "describe": "displacement_l within [0.5, 9]"
      },
      {
        "id": "numeric_range:co2_tailpipe_gpm",
        "describe": "co2_tailpipe_gpm within [0, 1500]"
      },
      {
        "id": "numeric_range:ev_range_mi",
        "describe": "ev_range_mi within [0, 600]"
      },
      {
        "id": "enum_membership:drive",
        "describe": "drive is one of front_wheel_drive, rear_wheel_drive, all_wheel_drive, four_wheel_drive, part_time_four_wheel_drive, four_or_all_wheel_drive, two_wheel_drive"
      },
      {
        "id": "numeric_range:potentially_affected",
        "describe": "potentially_affected within [0, 100000000]"
      }
    ]
  },
