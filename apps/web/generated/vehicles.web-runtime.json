        {
          "id": "manufacturers",
          "path": "/sitemaps/makes-{n}.xml"
        },
        {
          "id": "entities",
          "path": "/sitemaps/entities-{n}.xml"
        },
        {
          "id": "relationships",
          "path": "/sitemaps/relationships-{n}.xml"
        }
      ]
    },
    "canonical": {
      "redirect_on_merge": true,
      "redirect_status": 301,
      "filter_pages_canonicalize_to_parent": true,
      "trailing_slash": false,
      "preserve_slugs_after_merge": true
    },
    "structured_data": {
      "dataset_page": {
        "type": "Dataset",
        "required_fields": [
          "name",
          "description",
          "creator",
          "dateModified",
          "license",
          "distribution",
          "keywords",
          "temporalCoverage"
        ]
      },
      "catalog_page": {
        "type": "DataCatalog",
        "required_fields": [
          "name",
          "description",
          "dataset"
        ]
      },
      "entity_page": {
        "type": null,
        "reason": "Schema.org `Car` / `Product` imply a vehicle offered for sale. A model year's recalls and label fuel economy are neither."
      }
    },
    "images": {
      "require_rights_decision": true,
      "fallback_to_generated_visualizations": true,
      "require_alt_text": true,
      "alt_text_template": "{canonical_name}",
      "note": "No source in this vertical supplies images, and none are acquired."
    },
    "llm_discovery": {
      "llms_txt": "/vehicles/llms.txt",
      "llms_full_txt": "/vehicles/llms-full.txt",
      "markdown_representation": true,
      "accept_text_markdown": true,
      "include": [
        "dataset_description",
        "resource_groups",
        "schemas",
        "api_docs",
        "openapi_url",
        "mcp_endpoint",
        "bulk_formats",
        "source_methodology",
        "freshness_and_changelog",
        "licensing_and_access_terms"
      ],
      "markdown_for_non_indexable": true,
      "markdown_includes_coverage_notice": true
    },
    "agent_intents": {
      "recall_lookup": {
        "tool": "traverse_relationships",
        "examples": [
          "Are there recalls on a {model_year} {make} {model}?",
          "What recalls affect the {model_year} {model}?",
          "Is there a do-not-drive recall for {make} {model} {model_year}?"
        ]
      },
      "identifier_resolution": {
        "tool": "get_entity",
        "examples": [
          "What is recall {nhtsa_campaign_number}?",
          "Look up EPA vehicle {epa_vehicle_id}",
          "Find the {model_year} {make} {model}"
        ]
      },
      "spec_search": {
        "tool": "search_entities",
        "examples": [
          "Which {model_year} SUVs get more than 30 mpg combined?",
          "List electric vehicles with at least 250 miles of range"
        ]
      },
      "evidence_lookup": {
        "tool": "explain_fact",
        "examples": [
          "Where does the combined mpg for {model} come from?",
          "Who reported recall {nhtsa_campaign_number}?"
        ]
      },
      "comparison": {
        "tool": "compare_entities",
        "examples": [
          "Compare the fuel economy of {model_a} and {model_b}"
        ]
      }
    },
    "guardrail": "Doc 07: be the best factual result, not a page generator. A recall page must never imply a specific vehicle is (or is not) affected; only a VIN check can say that."
  },
  "filters": {
    "defaults": {
      "robots": "noindex,follow",
      "facet_count": true,
      "sort": false,
      "search_boost": 0,
      "indexable": false
    },
    "fields": [
      {
        "field": "make",
        "label": "Make",
        "entity_type": "vehicle_configuration",
        "value_type": "string",
        "unit": null,
        "filter": {
          "type": "multi_select",
          "facet_count": true
        },
        "sort": false,
        "search_boost": 0.9,
        "indexable": true,
        "seo": {
          "indexable": true,
          "min_results": 5,
          "demand_threshold": 0.9
        },
        "rationale": "The first thing anyone types. A make is a real entity with its own page, so a lower result floor is legitimate."
      },
      {
        "field": "model_year",
        "label": "Model year",
        "entity_type": "vehicle_model_year",
        "value_type": "integer",
        "unit": null,
        "filter": {
          "type": "range",
          "facet_count": true
        },
        "sort": true,
        "search_boost": 0.7,
        "indexable": true,
        "seo": {
          "indexable": "conditional",
          "min_results": 10,
          "demand_threshold": 0.7
        },
        "rationale": "The second half of every recall question (\"2020 Accord recall\")."
      },
      {
        "field": "model_name",
        "label": "Model",
        "entity_type": "vehicle_model_year",
        "value_type": "string",
        "unit": null,
        "filter": {
          "type": "multi_select",
          "facet_count": true
        },
        "sort": true,
        "search_boost": 0.8,
        "indexable": false,
        "seo": {
          "indexable": false,
          "reason": "A model page is the model-year entity page; a model facet page would duplicate it."
