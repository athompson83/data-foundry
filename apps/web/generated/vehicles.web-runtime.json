    "indexable_combinations": [
      {
        "id": "make_by_model_year",
        "fields": [
          "make",
          "model_year"
        ],
        "max_depth": 2,
        "min_results": 10,
        "rationale": "\"2020 Examplar Motors recalls\" style navigation: a real intent with a distinct result set, and the only combination allowed."
      }
    ],
    "denied_combinations": [
      {
        "fields": [
          "combined_mpg",
          "city_mpg"
        ],
        "reason": "Correlated ratings; near-identical result sets."
      },
      {
        "pattern": "any_combination_of_three_or_more",
        "reason": "Deeper filtering stays available in the UI and API; it never becomes an indexable URL."
      }
    ]
