      },
      {
        "field": "drive",
        "label": "Drive",
        "entity_type": "vehicle_configuration",
        "value_type": "string",
        "unit": null,
        "filter": {
          "type": "multi_select",
          "facet_count": true,
          "options": [
            "front_wheel_drive",
            "rear_wheel_drive",
