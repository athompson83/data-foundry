    "page_classes": [
      {
        "id": "dataset_landing",
        "route_kind": "static",
        "path": "/vehicles",
        "title": "US Vehicle Recalls & Fuel Economy Data",
        "structured_data": "Dataset",
        "sitemap": "datasets",
        "indexable": true,
        "quality_gate": "dataset"
      },
      {
        "id": "vehicle_model_year_detail",
        "route_kind": "entity_detail",
