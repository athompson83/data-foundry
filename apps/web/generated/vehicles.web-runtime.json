        "title": "{canonical_name} recalls and fuel economy",
        "structured_data": null,
        "sitemap": "entities",
        "indexable": "conditional",
        "quality_gate": "entity_detail",
        "description": "The core page: the recalls touching a model year and its EPA-tested configurations. structured_data is null: Schema.org `Car`/`Product` would imply an offer we do not make."
      },
      {
        "id": "make_detail",
        "route_kind": "entity_detail",
        "entity_type": "make",
        "path": "/vehicles/makes/{canonical_slug}",
        "title": "{canonical_name} recalls and fuel economy",
        "structured_data": null,
        "sitemap": "manufacturers",
        "indexable": "conditional",
        "quality_gate": "make"
      },
      {
        "id": "vehicle_configuration_detail",
        "route_kind": "entity_detail",
        "entity_type": "vehicle_configuration",
        "path": "/vehicles/configurations/{canonical_slug}",
        "title": "{canonical_name}",
        "structured_data": null,
        "sitemap": null,
        "indexable": false,
        "quality_gate": "configuration",
        "description": "Never indexed: a configuration page is a fragment of its model-year page and would duplicate it. Available on API, MCP and as a noindex page."
      },
      {
        "id": "recall_campaign_detail",
        "route_kind": "entity_detail",
        "entity_type": "recall_campaign",
        "path": "/vehicles/recalls/{canonical_slug}",
        "title": "NHTSA recall {nhtsa_campaign_number}",
        "structured_data": null,
        "sitemap": "entities",
        "indexable": "conditional",
        "quality_gate": "recall",
        "description": "People search campaign numbers directly, so a campaign page earns an index slot at a lower content bar if its facts are complete."
      },
      {
        "id": "recall_relationship",
        "route_kind": "relationship",
        "subject_entity_type": "vehicle_model_year",
