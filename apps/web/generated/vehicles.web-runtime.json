        "unit": null,
        "filter": {
          "type": "multi_select",
          "facet_count": true
        },
        "sort": false,
        "search_boost": 0.5,
        "indexable": false,
        "seo": {
          "indexable": false,
          "reason": "Qualifier on a make/model search, not a search of its own."
