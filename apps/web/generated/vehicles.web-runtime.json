            "four_wheel_drive",
            "part_time_four_wheel_drive",
            "four_or_all_wheel_drive",
            "two_wheel_drive"
          ]
        },
        "sort": false,
        "search_boost": 0.3,
        "indexable": false,
        "seo": {
          "indexable": false,
          "reason": "Qualifier only."
        }
      },
      {
        "field": "vehicle_class",
        "label": "EPA size class",
        "entity_type": "vehicle_configuration",
        "value_type": "string",
        "unit": null,
        "filter": {
          "type": "multi_select",
          "facet_count": true
        },
        "sort": false,
        "search_boost": 0.4,
        "indexable": false,
        "seo": {
          "indexable": false,
          "reason": "EPA's class strings are retained as published and not yet a controlled vocabulary."
