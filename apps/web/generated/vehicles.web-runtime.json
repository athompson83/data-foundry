      },
      {
        "field": "powertrain_type",
        "label": "Powertrain",
        "entity_type": "vehicle_configuration",
        "value_type": "string",
        "unit": null,
        "filter": {
          "type": "multi_select",
          "facet_count": true
        },
        "sort": false,
        "search_boost": 0.5,
        "indexable": false,
        "seo": {
          "indexable": false,
          "reason": "Absent for conventional vehicles, so a facet silently drops most of the catalogue."
        }
      },
      {
        "field": "combined_mpg",
