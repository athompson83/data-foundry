  "identifier_normalization": {
    "version": 1,
    "rules": [
      {
        "alias_type": "make_model_year",
        "applies_to": [
          "vehicle_model_year"
        ],
        "scoped_to": null,
        "strong": true,
        "ops": [
          {
            "op": "uppercase"
          },
          {
            "op": "strip_characters",
            "characters": "-_. /\\"
          },
          {
            "op": "strip_whitespace"
          }
        ],
        "validate": {
          "min_length": 6,
          "max_length": 120,
          "pattern": "^[A-Z0-9]+[0-9]{4}$"
        }
      },
      {
        "alias_type": "epa_vehicle_id",
        "applies_to": [
          "vehicle_configuration"
        ],
        "scoped_to": null,
        "strong": true,
        "ops": [
          {
            "op": "uppercase"
          },
          {
            "op": "strip_characters",
            "characters": "-_. /\\"
          },
          {
            "op": "strip_whitespace"
          }
        ],
        "validate": {
          "min_length": 1,
          "max_length": 8,
          "pattern": "^[0-9]+$"
        }
      },
      {
        "alias_type": "nhtsa_campaign_number",
        "applies_to": [
          "recall_campaign"
        ],
        "scoped_to": null,
