  "identifier_normalization": {
    "version": 1,
    "rules": [
      {
        "alias_type": "model_number",
        "applies_to": [
          "equipment_model"
        ],
        "scoped_to": null,
        "strong": true,
        "ops": [
          {
            "op": "uppercase"
          },
          {
            "op": "strip_characters",
            "characters": "-_. /\\"
          },
          {
            "op": "strip_whitespace"
          }
        ],
        "validate": {
          "min_length": 6,
          "max_length": 32,
          "pattern": "^[A-Z0-9]+$"
        }
      },
      {
        "alias_type": "ahri_ref",
        "applies_to": [
          "equipment_model",
          "certification"
        ],
        "scoped_to": null,
        "strong": true,
        "ops": [
          {
            "op": "uppercase"
          },
          {
            "op": "strip_prefix",
            "prefixes": [
              "AHRI",
              "AHRI-",
              "AHRI "
            ]
          },
          {
            "op": "strip_characters",
            "characters": "-_. /"
          },
          {
            "op": "strip_whitespace"
          }
        ],
        "validate": {
          "min_length": 6,
          "max_length": 16,
          "pattern": "^[0-9]+$"
        }
      },
      {
        "alias_type": "manufacturer_sku",
        "applies_to": [
          "equipment_model"
        ],
        "scoped_to": "manufacturer",
        "strong": true,
        "ops": [
          {
            "op": "uppercase"
          },
          {
            "op": "collapse_whitespace"
          },
          {
            "op": "strip_whitespace"
          }
        ],
        "validate": {
          "min_length": 3,
          "max_length": 64,
          "pattern": "^[A-Z0-9][A-Z0-9-]*$"
        }
      },
      {
        "alias_type": "upc",
        "applies_to": [
          "equipment_model"
        ],
        "scoped_to": null,
        "strong": true,
        "ops": [
          {
            "op": "strip_non_digits"
          },
          {
            "op": "left_pad",
            "length": 12,
            "character": "0"
          }
        ],
        "validate": {
          "min_length": 12,
          "max_length": 14,
          "pattern": "^[0-9]{12,14}$",
          "checksum": "upc_mod10"
        }
      },
      {
        "alias_type": "series_name",
