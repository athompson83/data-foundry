{
  "name": "data-foundry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm run schemas:generate && pnpm run typecheck",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json",
    "migrate": "tsx tooling/scripts/migrate.ts",
    "migrate:check": "tsx tooling/scripts/migrate.ts --check",
    "schemas:generate": "tsx tooling/scripts/generate-json-schemas.ts",
    "schemas:check": "tsx tooling/scripts/generate-json-schemas.ts --check",
    "openapi:generate": "tsx tooling/scripts/generate-openapi.ts",
    "openapi:check": "tsx tooling/scripts/generate-openapi.ts --check",
    "verticals:validate": "tsx tooling/validators/validate-verticals.ts",
    "verticals:compile": "tsx tooling/scripts/compile-vertical-runtime.ts",
    "verticals:compile:check": "tsx tooling/scripts/compile-vertical-runtime.ts --check",
    "cloudflare:topology:check": "tsx tooling/scripts/check-cloudflare-topology.ts",
    "cloudflare:artifacts:check": "tsx tooling/scripts/check-cloudflare-artifacts.ts",
    "web:compile": "tsx tooling/scripts/compile-web-runtime.ts",
    "web:compile:check": "tsx tooling/scripts/compile-web-runtime.ts --check",
    "sources:readiness": "tsx tooling/scripts/source-readiness.ts"
  },
  "devDependencies": {
    "@data-foundry/canonical-schema": "workspace:*",
    "@data-foundry/source-registry": "workspace:*",
    "@electric-sql/pglite": "^0.5.5",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.15.5",
    "esbuild": "^0.24.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "smol-toml": "1.8.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "4.127.1",
    "yaml": "^2.7.0",
    "zod": "^4.4.3"
  }
}
