{"analytics_identifier":null,"base_path":"/product-safety-alerts-reports-recalls/product-recall-helly-hansen-as-buoyancy-aids-2605-0143","content_id":"6f81c3c5-808e-40e1-9e53-1f677b845968","description":"Product Recall for Helly Hansen AS Buoyancy Aids presenting a risk of drowning. ","details":{"attachments":[{"attachment_type":"file","content_id":"375210a2-a353-4ab0-a965-2f1562b588b1","content_type":"application/pdf","created_at":"2026-06-25T14:42:47+01:00","id":"375210a2-a353-4ab0-a965-2f1562b588b1","title":"Link to product image and PDF","updated_at":"2026-06-25T14:42:47+01:00","url":"https://assets.publishing.service.gov.uk/media/6a3d3057d52550a19950f4f2/2605-0143-product-recall-helly-hansen-varied-buoyancy-aids.pdf"}],"body":"<h2 id=\"summary\">Summary</h2>\n\n<p>Product: Helly Hansen AS Buoyancy Aids</p>\n\n<p>Hazard: The product presents a serious risk of drowning as it may not provide enough buoyancy and turning momentum to bring the user face up in the water.</p>\n\n<p>Corrective action: The product has been recalled from end users by Helly Hansen AS.</p>\n\n<h2 id=\"product-information\">Product information</h2>\n\n<table>\n  <thead>\n    <tr>\n      <th scope=\"col\">Type</th>\n      <th scope=\"col\">Personal protective equipment (PPE) - Lifebelts/Lifejackets/Lifesuits</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <td>Brand</td>\n      <td>Helly Hansen AS </td>\n    </tr>\n    <tr>\n      <td>Styles</td>\n      <td>33818 SPORT II, 33811 - Comfort Compact 50N, 34258 - Rider Kayak Vest, 34240 - Rider Foil Race </td>\n    </tr>\n    <tr>\n      <td>Country of Origin</td>\n      <td>China</td>\n    </tr>\n    <tr>\n      <td>Product Description</td>\n      <td>Various styles of buoyancy aids. Please see the Annex below for sizes and serial numbers.</td>\n    </tr>\n    <tr>\n      <td>Product Report and Image</td>\n      <td><span id=\"attachment_375210a2-a353-4ab0-a965-2f1562b588b1\" class=\"attachment-inline\"><a href=\"https://assets.publishing.service.gov.uk/media/6a3d3057d52550a19950f4f2/2605-0143-product-recall-helly-hansen-varied-buoyancy-aids.pdf\">Link to product image and PDF</a></span></td>\n    </tr>\n  </tbody>\n</table>\n\n<h3 id=\"affected-products\">Affected products</h3>\n\n<table>\n  <thead>\n    <tr>\n      <th scope=\"col\">Style Code</th>\n      <th scope=\"col\">Size</th>\n      <th scope=\"col\">Serial Numbers</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <td>33818 SPORT II</td>\n      <td>XXS (30-40 kg)</td>\n      <td>271011, 271012, 272150, 271612, 275325, 275969, 279873, 281286, 291307</td>\n    </tr>\n    <tr>\n      <td>33811 - Comfort Compact 50N</td>\n      <td>All sizes</td>\n      <td>All serial numbers</td>\n    </tr>\n    <tr>\n      <td>34258 - Rider Kayak Vest</td>\n      <td>All sizes</td>\n      <td>All serial numbers</td>\n    </tr>\n    <tr>\n      <td>34240 - Rider Foil Race</td>\n      <td>All sizes</td>\n      <td>All serial numbers</td>\n    </tr>\n  </tbody>\n</table>\n\n<h2 id=\"hazard\">Hazard</h2>\n\n<p>The product presents a risk of drowning as it may not provide enough buoyancy and turning momentum to bring the user face up in the water. </p>\n\n<p>The product does not meet the requirements of Regulation 2016/425 or the Personal Protective Equipment (Enforcement) Regulations 2018.</p>\n\n<h2 id=\"corrective-action\">Corrective action</h2>\n\n<p>The product has been recalled from end users by Helly Hansen AS.   </p>\n\n<p>Consumers should immediately stop using the recalled items and contact Helly Hansen - <a href=\"mailto:recall@hellyhansen.com\">recall@hellyhansen.com</a> - for a credit note or refund.   </p>\n\n<p>For more information please access: <a rel=\"external\" href=\"https://www.hellyhansen.com/recall\">https://www.hellyhansen.com/recall</a></p>\n\n<h3 id=\"additional-information\">Additional information</h3>\n\n<p>PSD notification number: 2605-0143</p>\n\n<p>Notified by: Local Authority Trading Standards</p>\n","change_history":[{"note":"First published.","public_timestamp":"2026-06-12T13:13:59Z"}],"headers":[{"id":"summary","level":2,"text":"Summary"},{"headers":[{"id":"affected-products","level":3,"text":"Affected products"}],"id":"product-information","level":2,"text":"Product information"},{"id":"hazard","level":2,"text":"Hazard"},{"headers":[{"id":"additional-information","level":3,"text":"Additional information"}],"id":"corrective-action","level":2,"text":"Corrective action"}],"max_cache_time":10,"metadata":{"product_alert_type":"product-recall","product_category":"personal-protective-equipment-ppe","product_measure_type":["recall-of-product-from-end-users"],"product_recall_alert_date":"2026-06-12","product_risk_level":"medium"},"temporary_update_type":false},"document_type":"product_safety_alert_report_recall","first_published_at":"2026-06-12T14:14:00+01:00","links":{"available_translations":[{"api_path":"/api/content/product-safety-alerts-reports-recalls/product-recall-helly-hansen-as-buoyancy-aids-2605-0143","api_url":"https://www.gov.uk/api/content/product-safety-alerts-reports-recalls/product-recall-helly-hansen-as-buoyancy-aids-2605-0143","base_path":"/product-safety-alerts-reports-recalls/product-recall-helly-hansen-as-buoyancy-aids-2605-0143","content_id":"6f81c3c5-808e-40e1-9e53-1f677b845968","document_type":"product_safety_alert_report_recall","links":{},"locale":"en","public_updated_at":"2026-06-12T13:14:00Z","schema_name":"specialist_document","title":"Product Recall: Helly Hansen AS Buoyancy Aids (2605-0143)","web_url":"https://www.gov.uk/product-safety-alerts-reports-recalls/product-recall-helly-hansen-as-buoyancy-aids-2605-0143","withdrawn":false}],"finder":[{"api_path":"/api/content/product-safety-alerts-reports-recalls","api_url":"https://www.gov.uk/api/content/product-safety-alerts-reports-recalls","base_path":"/product-safety-alerts-reports-recalls","content_id":"a22b3f1f-2c91-49a1-a469-ff21d465c543","details":{"facets":[{"allowed_values":[{"label":"Product safety alert","