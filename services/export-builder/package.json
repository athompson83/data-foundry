{
  "name": "@data-foundry/export-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Versioned dataset manifests and bulk export (JSONL/CSV) built on the canonical query layer, gated by the AGENTS.md rule 1 publish gate.",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run --root .",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@data-foundry/canonical-schema": "workspace:*",
    "@data-foundry/canonical-store": "workspace:*",
    "@data-foundry/provenance": "workspace:*",
    "@data-foundry/query-model": "workspace:*",
    "@data-foundry/source-registry": "workspace:*"
  }
}
